<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="payment_voucher_match_table">
        <t t-if="values.get('display_match_lines')">
            <table t-attf-style="width: 100%; border-collapse: collapse; font-size: #{font_size};">
                <thead>
                    <tr>
                        <th style="border: 1px solid #000; padding: 6px; width: 5%; text-align: center;">No.</th>
                        <th style="border: 1px solid #000; padding: 6px; width: 14%; text-align: center;">Date</th>
                        <th style="border: 1px solid #000; padding: 6px; width: 22%; text-align: center;">Document</th>
                        <th style="border: 1px solid #000; padding: 6px; text-align: center;">Reference</th>
                        <th t-if="values.get('show_pc_cc')" style="border: 1px solid #000; padding: 6px; width: 12%; text-align: center;">PC/CC</th>
                        <th t-if="values.get('show_foreign_currency')" style="border: 1px solid #000; padding: 6px; width: 16%; text-align: center;">Amount in Currency</th>
                        <th style="border: 1px solid #000; padding: 6px; width: 16%; text-align: center;">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="values.get('lines')" t-as="line">
                        <td style="border: 1px solid #000; padding: 6px; text-align: center;">
                            <span t-esc="line_index + 1"/>
                        </td>
                        <td style="border: 1px solid #000; padding: 6px; white-space: nowrap;">
                            <span t-esc="line.get('date') and line.get('date').strftime('%d-%b-%Y') or ''"/>
                        </td>
                        <td style="border: 1px solid #000; padding: 6px;">
                            <span t-esc="line.get('document_number')"/>
                        </td>
                        <td style="border: 1px solid #000; padding: 6px; overflow-wrap: anywhere;">
                            <span t-esc="line.get('reference')"/>
                        </td>
                        <td t-if="values.get('show_pc_cc')" style="border: 1px solid #000; padding: 6px;">
                            <span t-esc="line.get('pc_cc')"/>
                        </td>
                        <td t-if="values.get('show_foreign_currency')" style="border: 1px solid #000; padding: 6px; text-align: right; white-space: nowrap;">
                            <span t-if="line.get('line_currency') != values.get('company_currency')"
                                  t-out="line.get('amount_currency')"
                                  t-options="{'widget': 'monetary', 'display_currency': line.get('line_currency')}"/>
                        </td>
                        <td style="border: 1px solid #000; padding: 6px; text-align: right; white-space: nowrap;">
                            <span t-out="line.get('amount_company')"
                                  t-options="{'widget': 'monetary', 'display_currency': values.get('company_currency')}"/>
                        </td>
                    </tr>
                </tbody>
            </table>

            <table t-attf-style="width: 40%; margin-left: auto; border-collapse: collapse; margin-top: 18px; font-size: #{font_size};">
                <tr>
                    <td style="border: 1px solid #000; padding: 6px;">
                        <strong>Due Amount</strong>
                    </td>
                    <td style="border: 1px solid #000; padding: 6px; text-align: right; white-space: nowrap;">
                        <strong>
                            <span t-out="values.get('difference_company_amount')"
                                  t-options="{'widget': 'monetary', 'display_currency': values.get('company_currency')}"/>
                        </strong>
                    </td>
                </tr>
            </table>
        </t>
    </template>

    <template id="ytk_voucher_body">
        <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang or o.company_id.partner_id.lang)"/>
        <t t-set="display_values" t-value="o._get_payment_voucher_display_values()"/>
        <t t-set="values" t-value="o._get_payment_voucher_match_values()"/>
        <t t-set="letterhead" t-value="o.env.ref('tha_payment_voucher_report.attachment_ytk_voucher_header', raise_if_not_found=False)"/>

        <t t-call="web.basic_layout">
            <div class="page"
                 t-att-style="'position: relative; font-size: %s; height: %s; min-height: %s; padding-bottom: 0; overflow: hidden;' % (font_size, page_height, page_height)">
                <t t-if="letterhead and letterhead.datas">
                    <img t-att-src="image_data_uri(letterhead.datas)"
                         style="position: absolute; top: 0; left: 0; width: 100%; height: auto; z-index: 0;"
                         alt="YTK Header"/>
                </t>

                <div t-att-style="'position: relative; z-index: 1; padding-top: %s;' % content_top_padding">
                    <div style="margin-bottom: 18px;">
                        <h3 style="margin: 0; font-weight: bold;">
                            <span t-esc="display_values.get('title')"/>
                        </h3>
                    </div>

                    <table t-attf-style="width: 100%; border-collapse: collapse; margin-bottom: 18px; font-size: #{font_size}; line-height: 1.6;">
                        <tr>
                            <td style="width: 50%; vertical-align: top; border: 1px solid #000; padding: 7px;">
                                <strong t-esc="display_values.get('partner_label') + ':'"/>
                                <span t-esc="o.partner_id.display_name"/><br/>

                                <strong t-esc="display_values.get('document_label') + ':'"/>
                                <span t-field="o.name"/><br/>

                                <strong t-esc="display_values.get('amount_label') + ':'"/>
                                <span t-out="values.get('payment_display_amount')"
                                      t-options="{'widget': 'monetary', 'display_currency': values.get('payment_display_currency')}"/><br/>

                                <strong>Journal:</strong>
                                <span t-field="o.journal_id"/>
                            </td>

                            <td style="width: 50%; vertical-align: top; border: 1px solid #000; padding: 7px;">
                                <strong>Currency:</strong>
                                <span t-field="o.currency_id"/><br/>

                                <strong>Payment Date:</strong>
                                <span t-esc="o.date and o.date.strftime('%d-%b-%Y') or ''"/><br/>

                                <strong>Payment Method:</strong>
                                <span t-if="o.payment_method_id" t-field="o.payment_method_id.name"/><br/>

                                <strong>Memo:</strong>
                                <span t-if="o.memo" t-field="o.memo"/>
                            </td>
                        </tr>
                    </table>

                    <t t-call="tha_payment_voucher_report.payment_voucher_match_table"/>
                </div>

                <div t-attf-style="position: absolute; left: 0; right: 0; bottom: #{signature_bottom}; width: 100%; z-index: 2; page-break-inside: avoid;">
                    <table t-attf-style="width: 100%; text-align: center; border-collapse: collapse; font-size: #{font_size};">
                        <tr>
                            <td style="width: 33.33%; vertical-align: top; border: none;">
                                <strong>Approved By:</strong>
                                <div style="margin-top: 45px;">Sign ................................</div>
                                <div style="margin-top: 15px;">Name ................................</div>
                            </td>
                            <td style="width: 33.33%; vertical-align: top; border: none;">
                                <strong>Received By:</strong>
                                <div style="margin-top: 45px;">Sign ................................</div>
                                <div style="margin-top: 15px;">Name ................................</div>
                            </td>
                            <td style="width: 33.33%; vertical-align: top; border: none;">
                                <strong>Paid By:</strong>
                                <div style="margin-top: 45px;">Sign ................................</div>
                                <div style="margin-top: 15px;">Name ................................</div>
                            </td>
                        </tr>
                    </table>
                </div>

                <div style="position: absolute; left: 0; right: 0; bottom: 0mm; width: 100%; z-index: 2; text-align: center; font-size: 12px; color: #333; page-break-inside: avoid;">
                    <div style="border-top: 1px dotted #000; width: 100%; height: 1px; margin: 0 0 6px 0;"/>
                    <div><strong>YGN Office</strong></div>
                    <div>Ph: 09 765488330, 09 765488331</div>
                </div>
            </div>
        </t>
    </template>
</odoo>

<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="customer_receipt_voucher">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="tha_payment_voucher_report.tpc_voucher_body">
                    <t t-set="font_size" t-value="'13px'"/>
                    <t t-set="page_height" t-value="'340mm'"/>

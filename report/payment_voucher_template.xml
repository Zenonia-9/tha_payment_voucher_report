<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="vendor_payment_voucher">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="lang" t-value="o.partner_id.lang or o.company_id.partner_id.lang"/>
                <t t-set="o" t-value="o.with_context(lang=lang)"/>
                <t t-set="company" t-value="o.company_id.sudo()"/>
                <!-- <t t-set="layout_document_title" t-value="'Vendor Payment Voucher'"/> -->
                <t t-call="tha_payment_voucher_report.payment_voucher_layout_a4">
                    <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
                    <t t-set="values" t-value="o._get_payment_voucher_match_values()"/>

                    <style>
                        .page {
                            font-size: 14px;
                        }

                        .voucher-info .fw-bold {
                            white-space: nowrap;
                        }

                        .voucher-info .col-7 {
                            overflow-wrap: anywhere;
                        }

                        .compact-table {
                            table-layout: auto;
                            width: 100%;
                        }

                        .compact-table td,
                        .compact-table th {
                            line-height: 1.5 !important;
                            vertical-align: middle;
                            padding: 4px 5px !important;
                            overflow-wrap: anywhere;
                        }

                        .compact-table .amount-cell {
                            white-space: nowrap;
                        }

                        .compact-table tr {
                            height: auto !important;
                        }
                    </style>

                    <div class="page">

                        <!-- TITLE -->
                        <div class="text-center mb-3">
                            <h4 style="font-weight: bold; margin: 0;">Payment Voucher</h4>
                        </div>

                        <!-- HEADER -->
                        <div class="row mb-2 voucher-info">
                            <div class="col-6">
                                <div class="row mb-1">
                                    <div class="col-5 fw-bold">Payment Voucher</div>
                                    <div class="col-7"><span t-field="o.name"/></div>
                                </div>
                                <div class="row mb-1">
                                    <div class="col-5 fw-bold">Supplier</div>
                                    <div class="col-7"><span t-field="o.partner_id"/></div>
                                </div>
                                <div class="row mb-1">
                                    <div class="col-5 fw-bold">Payment Amount</div>
                                    <div class="col-7">
                                        <span t-out="values.get('payment_display_amount')" t-options="{'widget': 'monetary', 'display_currency': values.get('payment_display_currency')}"/>
                                    </div>
                                </div>
                                <div class="row mb-1">
                                    <div class="col-5 fw-bold">Journal</div>
                                    <div class="col-7"><span t-field="o.journal_id"/></div>
                                </div>
                            </div>

                            <div class="col-6">
                                <div class="row mb-1">
                                    <div class="col-5 fw-bold">Currency</div>
                                    <div class="col-7"><span t-field="o.currency_id"/></div>
                                </div>

                                <div class="row mb-1" t-if="o.date">
                                    <div class="col-5 fw-bold">Payment Date</div>
                                    <div class="col-7">
                                        <span t-esc="o.date and o.date.strftime('%d-%b-%Y') or ''"/>
                                    </div>
                                </div>

                                <div class="row mb-1" t-if="o.payment_method_id">
                                    <div class="col-5 fw-bold">Payment Method</div>
                                    <div class="col-7"><span t-field="o.payment_method_id.name"/></div>
                                </div>
                                <div class="row mb-1" t-if="o.memo">
                                    <div class="col-5 fw-bold">Memo</div>
                                    <div class="col-7"><span t-field="o.memo"/></div>
                                </div>
                            </div>
                        </div>

                        <t t-call="tha_payment_voucher_report.payment_voucher_match_table"/>

                        <!-- TABLE -->
                        <table name="invoices" t-if="values.get('display_invoices')" class="table table-borderless compact-table">

                            <!-- FIX 1: safe sort (Odoo-safe style) -->
                            <t t-set="invoices" t-value="(o.reconciled_invoice_ids or o.reconciled_bill_ids)                             .sorted(key=lambda i: i.invoice_date or i.date)"/>

                            <t t-set="otherCurrency" t-value="any(inv.currency_id != o.currency_id for inv in invoices)"/>
                            <t t-set="show_pc_cc" t-value="any(inv.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note') and l.analytic_distribution) for inv in invoices if inv.move_type != 'entry')"/>

                            <thead>
                                <tr>
                                    <th style="width: 10mm;">No</th>
                                    <th style="width: 25mm;">Bill Date</th>
                                    <th style="width: 40mm;">Bill Number</th>
                                    <th>Reference</th>
                                    <th t-if="show_pc_cc" style="width: 15mm;">PC/CC</th>
                                    <th t-if="otherCurrency" class="text-end">
                                        Paid (<span t-field="o.currency_id.name"/>)
                                    </th>
                                    <th class="text-end">Amount</th>
                                </tr>
                            </thead>

                            <tbody>
                                <t t-set="i" t-value="0"/>
                                <t t-set="total_applied" t-value="0.0"/>

                                <t t-foreach="invoices" t-as="inv">

                                    <t t-if="inv.move_type != 'entry'">

                                        <!-- FIX 2: correct signed logic (better than only invoice type) -->
                                        <t t-set="signed_total" t-value="inv.amount_total if inv.move_type == 'in_invoice' else -inv.amount_total"/>

                                        <t t-set="i" t-value="i + 1"/>
                                        <t t-set="total_applied" t-value="total_applied + signed_total"/>

                                        <tr>
                                            <td><span t-esc="i"/></td>

                                            <td>
                                                <span t-esc="inv.invoice_date and inv.invoice_date.strftime('%d-%b-%Y') or ''"/>
                                            </td>

                                            <td><span t-field="inv.name"/></td>

                                            <td>
                                                <span t-if="inv.vendor_ref" t-field="inv.vendor_ref"/>
                                                <span t-elif="inv.ref" t-field="inv.ref"/>
                                            </td>

                                            <td t-if="show_pc_cc">
                                                <t t-set="analytic_names" t-value="[]"/>
                                                <t t-foreach="inv.invoice_line_ids.filtered(lambda l: l.display_type not in ('line_section', 'line_note') and l.analytic_distribution)" t-as="line">
                                                    <t t-foreach="line.analytic_distribution.keys()" t-as="analytic_key">
                                                        <t t-foreach="str(analytic_key).split(',')" t-as="analytic_id">
                                                            <t t-if="analytic_id">
                                                                <t t-set="analytic_account" t-value="o.env['account.analytic.account'].browse(int(analytic_id))"/>
                                                                <t t-if="analytic_account.exists() and analytic_account.name not in analytic_names">
                                                                    <t t-set="analytic_names" t-value="analytic_names + [analytic_account.name]"/>
                                                                </t>
                                                            </t>
                                                        </t>
                                                    </t>
                                                </t>
                                                <span t-esc="', '.join(analytic_names)"/>
                                            </td>

                                            <!-- FIX 3: remove undefined variable -->
                                            <td t-if="otherCurrency" class="text-end amount-cell">
                                                <span t-out="signed_total" t-options="{'widget': 'monetary',                                                       'display_currency': o.currency_id}"/>
                                            </td>

                                            <td class="text-end amount-cell">
                                                <span t-out="signed_total" t-options="{'widget': 'monetary',                                                       'display_currency': inv.currency_id}"/>
                                            </td>
                                        </tr>

                                    </t>
                                </t>

                                <!-- FIX 4: correct colspan logic -->
                                <tr>
                                    <td colspan="3"/>
                                    <td t-att-colspan="(2 if show_pc_cc else 1) + (1 if otherCurrency else 0)" class="text-end">
                                        <strong>Due Amount</strong>
                                    </td>
                                    <td class="text-end amount-cell">
                                        <strong>
                                            <span t-out="abs(o.amount - total_applied)" t-options="{'widget': 'monetary',                                                   'display_currency': o.currency_id}"/>
                                        </strong>
                                    </td>
                                </tr>

                            </tbody>
                        </table>

                        <!-- SIGNATURE -->
                        <div class="mt-4" style="page-break-inside: avoid;">

                            <div class="row text-center">
                                <div class="col-4"><strong>Approved By</strong></div>
                                <div class="col-4"><strong>Received By</strong></div>
                                <div class="col-4"><strong>Paid By</strong></div>
                            </div>

                            <div class="row mt-3">
                                <t t-foreach="[1,2,3]" t-as="x">
                                    <div class="col-4 px-3">
                                        <div style="border-bottom: 1px dotted black; height: 24px;"/>
                                    </div>
                                </t>
                            </div>

                            <div class="row mt-3">
                                <t t-foreach="[1,2,3]" t-as="x">
                                    <div class="col-4 px-3">
                                        <div style="border-bottom: 1px dotted black; height: 24px;"/>
                                    </div>
                                </t>
                            </div>

                        </div>

                    </div>
                </t>
            </t>
        </t>
    </template>


<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="payment_voucher_layout_a4">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <!-- Resolve company -->
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

        <!-- Header: logo left, company address right -->
        <div t-attf-class="header o_company_#{company.id}_layout">
            <style>
                .payment-voucher-header {
                    width: 100%;
                    overflow: hidden;
                }

                .payment-voucher-logo-block {
                    float: left;
                    width: 45%;
                    text-align: left;
                }

                .payment-voucher-address-block {
                    float: right;
                    width: 55%;
                    text-align: right;
                    font-size: 12px;
                    line-height: 1.25;
                    white-space: nowrap;
                    padding-right: 6mm;
                }

                .payment-voucher-address-block div,
                .payment-voucher-address-block span {
                    white-space: nowrap !important;
                }

                .payment-voucher-logo {
                    max-height: 80px;
                }

                .payment-voucher-clear {
                    clear: both;
                }
            </style>

            <t t-set="partner" t-value="company.partner_id"/>

            <div class="payment-voucher-header">
                <div class="payment-voucher-logo-block">
                    <img t-if="company.logo"
                        class="payment-voucher-logo"
                        t-att-src="image_data_uri(company.logo)"
                        alt="Logo"/>
                </div>

                <div class="payment-voucher-address-block">
                    <div t-if="company.name">
                        <span t-esc="company.name"/>
                    </div>

                    <div t-if="partner.street">
                        <span t-esc="partner.street"/>
                    </div>

                    <div t-if="partner.street2">
                        <span t-esc="partner.street2"/>
                    </div>

                    <div t-if="partner.city or partner.state_id">
                        <span t-if="partner.city" t-esc="partner.city"/>
                        <span t-if="partner.city and partner.state_id"> </span>
                        <span t-if="partner.state_id" t-esc="partner.state_id.name"/>
                    </div>

                    <div t-if="partner.zip">
                        <span t-esc="partner.zip"/>
                    </div>

                    <div t-if="partner.country_id">
                        <span t-esc="partner.country_id.name"/>
                    </div>
                </div>

                <div class="payment-voucher-clear"/>
            </div>
        </div>

        <!-- Body -->
        <div t-attf-class="article o_report_layout_standard o_table_standard o_company_#{company.id}_layout"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>

        <!-- Footer -->
        <div t-attf-class="footer o_company_#{company.id}_layout">
            <div class="o_footer_content"/>
        </div>
    </template>

    <template id="payment_voucher_layout_a5">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <!-- Resolve company -->
        <t t-if="not company">
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

        <!-- Header: logo left, company address right -->
        <div t-attf-class="header o_company_#{company.id}_layout">
            <style>
                .payment-voucher-header {
                    width: 100%;
                    overflow: hidden;
                }

                .payment-voucher-logo-block {
                    float: left;
                    width: 45%;
                    text-align: left;
                }

                .payment-voucher-address-block {
                    float: right;
                    width: 55%;
                    text-align: right;
                    font-size: 11px;
                    line-height: 1.25;
                    white-space: nowrap;
                    padding-right: 6mm;
                }

                .payment-voucher-address-block div,
                .payment-voucher-address-block span {
                    white-space: nowrap !important;
                }

                .payment-voucher-logo {
                    max-height: 65px;
                }

                .payment-voucher-clear {
                    clear: both;
                }
            </style>

            <t t-set="partner" t-value="company.partner_id"/>

            <div class="payment-voucher-header">
                <div class="payment-voucher-logo-block">
                    <img t-if="company.logo"
                        class="payment-voucher-logo"
                        t-att-src="image_data_uri(company.logo)"
                        alt="Logo"/>
                </div>

                <div class="payment-voucher-address-block">
                    <div t-if="company.name">
                        <span t-esc="company.name"/>
                    </div>

                    <div t-if="partner.street">
                        <span t-esc="partner.street"/>
                    </div>

                    <div t-if="partner.street2">
                        <span t-esc="partner.street2"/>
                    </div>

                    <div t-if="partner.city or partner.state_id">
                        <span t-if="partner.city" t-esc="partner.city"/>
                        <span t-if="partner.city and partner.state_id"> </span>
                        <span t-if="partner.state_id" t-esc="partner.state_id.name"/>
                    </div>

                    <div t-if="partner.zip">
                        <span t-esc="partner.zip"/>
                    </div>

                    <div t-if="partner.country_id">
                        <span t-esc="partner.country_id.name"/>
                    </div>
                </div>

                <div class="payment-voucher-clear"/>
            </div>
        </div>

        <!-- Body -->
        <div t-attf-class="article o_report_layout_standard o_table_standard o_company_#{company.id}_layout"
             t-att-data-oe-model="o and o._name"
             t-att-data-oe-id="o and o.id"
             t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>

        <!-- Footer -->
        <div t-attf-class="footer o_company_#{company.id}_layout">
            <div class="o_footer_content"/>
        </div>
    </template>

    <template id="payment_voucher_match_table">
        <t t-if="values.get('display_match_lines')">
            <table name="payment_voucher_match_lines" class="table table-borderless compact-table">
                <thead>
                    <tr>
                        <th style="width: 8mm;">No</th>
                        <th>Date</th>
                        <th>Document</th>
                        <th>Reference</th>
                        <th t-if="values.get('show_pc_cc')" style="width: 15mm;">PC/CC</th>
                        <th t-if="values.get('show_foreign_currency')" class="text-end">
                            Amount in Currency
                        </th>
                        <th class="text-end">Amount</th>
                    </tr>
                </thead>
                <tbody>
                    <tr t-foreach="values.get('lines')" t-as="line">
                        <td><span t-esc="line_index + 1"/></td>
                        <td>
                            <span t-out="line.get('date')" t-options="{'widget': 'date', 'format': 'dd/MM/yyyy'}"/>
                        </td>
                        <td><span t-esc="line.get('document_number')"/></td>
                        <td><span t-esc="line.get('reference')"/></td>
                        <td t-if="values.get('show_pc_cc')"><span t-esc="line.get('pc_cc')"/></td>
                        <td t-if="values.get('show_foreign_currency')" class="text-end amount-cell">
                            <span t-if="line.get('line_currency') != values.get('company_currency')"
                                  t-out="line.get('amount_currency')"
                                  t-options="{'widget': 'monetary', 'display_currency': line.get('line_currency')}"/>
                        </td>
                        <td class="text-end amount-cell">
                            <span t-out="line.get('amount_company')"
                                  t-options="{'widget': 'monetary', 'display_currency': values.get('company_currency')}"/>
                        </td>
                    </tr>
                    <tr>
                        <td colspan="3"/>
                        <td t-att-colspan="(2 if values.get('show_pc_cc') else 1) + (1 if values.get('show_foreign_currency') else 0)" class="text-end">
                            <strong>Due Amount</strong>
                        </td>
                        <td class="text-end amount-cell">
                            <strong>
                                <span t-out="values.get('difference_company_amount')" t-options="{'widget': 'monetary', 'display_currency': values.get('company_currency')}"/>
                            </strong>
                        </td>
                    </tr>
                </tbody>
            </table>
        </t>
    </template>
</odoo>
